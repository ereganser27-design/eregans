(() => {
  'use strict';

  // Fill these with the NEW sharing-only project's URL and publishable key.
  const SUPABASE_URL = 'https://gjlfbjqsfdjybupwhhdw.supabase.co';
  const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_png0kpbpaT3OCoZO1UR5-Q_Fv7qDa79';
  let clientPromise;

  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[ch]);

  function notify(message) {
    const root = document.getElementById('toastRoot');
    if (!root) return;
    root.textContent = '';
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    root.append(toast);
    setTimeout(() => { if (toast.isConnected) toast.remove(); }, 3000);
  }

  function showShareModal(html) {
    const root = document.getElementById('modalRoot');
    root.innerHTML = '<div class="modal-layer"><section class="modal">' + html + '</section></div>';
    root.querySelector('.modal-layer').addEventListener('click', event => {
      if (event.target.classList.contains('modal-layer')) root.replaceChildren();
    });
    root.querySelectorAll('[data-share-close]').forEach(button => {
      button.addEventListener('click', () => root.replaceChildren());
    });
  }

  function getClient() {
    if (clientPromise) return clientPromise;
    if (!SUPABASE_URL || !SUPABASE_PUBLISHABLE_KEY) {
      return Promise.reject(new Error('share.jsに共有専用SupabaseのURLとPublishable keyを設定してください'));
    }
    clientPromise = new Promise((resolve, reject) => {
      const initialize = () => {
        if (!window.supabase?.createClient) {
          reject(new Error('Supabaseライブラリを読み込めませんでした'));
          return;
        }
        resolve(window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY));
      };
      if (window.supabase?.createClient) return initialize();
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2';
      script.onload = initialize;
      script.onerror = () => reject(new Error('Supabaseライブラリの読み込みに失敗しました'));
      document.head.append(script);
    });
    return clientPromise;
  }

  function makeShareId() {
    if (crypto.randomUUID) return crypto.randomUUID();
    const bytes = crypto.getRandomValues(new Uint8Array(16));
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    const hex = [...bytes].map(value => value.toString(16).padStart(2, '0')).join('');
    return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-' + hex.slice(12, 16) + '-' + hex.slice(16, 20) + '-' + hex.slice(20);
  }

  async function createShareLink() {
    const api = window.__ccdShareAPI;
    const project = api?.getProject();
    if (!project) return;
    if (location.protocol !== 'https:') {
      showShareModal('<h2>Web公開後に共有できます</h2><p>共有URLにはアプリの公開URLが必要です。GitHub Pagesなどへ公開した後、このプロジェクトから共有リンクを作成してください。</p><div class="modal-actions"><button data-share-close>閉じる</button></div>');
      return;
    }

    const button = document.getElementById('shareProject');
    if (button) button.disabled = true;
    try {
      const client = await getClient();
      const sessionResult = await client.auth.getSession();
      if (sessionResult.error) throw sessionResult.error;
      if (!sessionResult.data.session) {
        const signInResult = await client.auth.signInAnonymously();
        if (signInResult.error) throw signInResult.error;
      }
      const userResult = await client.auth.getUser();
      if (userResult.error || !userResult.data.user) {
        throw userResult.error || new Error('匿名ログインに失敗しました');
      }

      const payload = JSON.parse(JSON.stringify(project));
      delete payload.sharedSourceId;
      if (new TextEncoder().encode(JSON.stringify(payload)).length > 500000) {
        throw new Error('配線図のデータが大きすぎます（500KB以下にしてください）');
      }
      const id = makeShareId();
      const insertResult = await client.from('shared_diagrams').insert({
        id,
        owner_id: userResult.data.user.id,
        payload
      });
      if (insertResult.error) throw insertResult.error;

      const url = new URL(location.href);
      url.searchParams.set('id', id);
      url.hash = '';
      showShareModal('<h2>共有リンクを作成しました</h2><p>リンク先では閲覧用データが表示され、受け取った人の端末に編集用コピーが作られます。</p><label class="field"><span>共有URL</span><input id="sharedUrl" value="' + escapeHtml(url.href) + '" readonly></label><div class="modal-actions"><button data-share-close>閉じる</button><button class="primary" id="copySharedUrl">URLをコピー</button></div>');
      document.getElementById('copySharedUrl').addEventListener('click', async () => {
        const input = document.getElementById('sharedUrl');
        try {
          await navigator.clipboard.writeText(url.href);
        } catch {
          input.select();
          document.execCommand('copy');
        }
        notify('共有URLをコピーしました');
      });
    } catch (error) {
      showShareModal('<h2>共有リンクを作成できませんでした</h2><p>' + escapeHtml(error?.message || 'Supabaseへの接続に失敗しました') + '</p><p>共有用プロジェクトでSQLを実行し、匿名サインインを有効にしてください。</p><div class="modal-actions"><button data-share-close>閉じる</button></div>');
    } finally {
      if (button?.isConnected) button.disabled = false;
    }
  }

  const numberInRange = (value, fallback, min, max) => {
    const number = Number(value);
    return Number.isFinite(number) ? Math.max(min, Math.min(max, number)) : fallback;
  };
  const shortText = (value, fallback = '', max = 120) =>
    typeof value === 'string' ? value.slice(0, max) : fallback;
  const validColor = (value, fallback) =>
    typeof value === 'string' && /^#[0-9a-f]{6}$/i.test(value) ? value : fallback;
  const safePoint = value => value && typeof value === 'object' ? {
    x: numberInRange(value.x, 0, 0, 100000),
    y: numberInRange(value.y, 0, 0, 100000)
  } : null;

  function sanitizeSharedProject(source, shareId) {
    if (!source || typeof source !== 'object' || !Array.isArray(source.objects) || !Array.isArray(source.wires)) {
      throw new Error('共有データの形式が正しくありません');
    }
    const idMap = new Map();
    const objects = [];
    for (const object of source.objects.slice(0, 500)) {
      if (!object || typeof object !== 'object' || object.id == null) continue;
      const oldId = String(object.id);
      if (idMap.has(oldId)) continue;
      const id = Math.random().toString(36).slice(2, 10);
      idMap.set(oldId, id);
      objects.push({
        id,
        name: shortText(object.name, 'オブジェクト'),
        x: numberInRange(object.x, 0, 0, 100000),
        y: numberInRange(object.y, 0, 0, 100000),
        w: numberInRange(object.w, 150, 70, 3000),
        h: numberInRange(object.h, 82, 52, 3000),
        color: validColor(object.color, '#5966e8'),
        fontSize: numberInRange(object.fontSize, 14, 10, 32)
      });
    }
    const side = (value, fallback) => ['left', 'right', 'top', 'bottom'].includes(value) ? value : fallback;
    const anchor = (value, fallback) => ({
      side: side(value?.side, fallback),
      t: numberInRange(value?.t, 0.5, 0, 1)
    });
    const wires = [];
    for (const wire of source.wires.slice(0, 1500)) {
      if (!wire || typeof wire !== 'object' || !idMap.has(String(wire.from)) || !idMap.has(String(wire.to))) continue;
      wires.push({
        id: Math.random().toString(36).slice(2, 10),
        from: idMap.get(String(wire.from)),
        to: idMap.get(String(wire.to)),
        fromAnchor: anchor(wire.fromAnchor, 'right'),
        toAnchor: anchor(wire.toAnchor, 'left'),
        fromFree: safePoint(wire.fromFree),
        toFree: safePoint(wire.toFree),
        name: shortText(wire.name),
        terminalA: shortText(wire.terminalA),
        terminalB: shortText(wire.terminalB),
        connectorA: shortText(wire.connectorA),
        connectorB: shortText(wire.connectorB),
        color: validColor(wire.color, '#5866dc'),
        routeOffset: numberInRange(wire.routeOffset, 0, -100000, 100000)
      });
    }
    return {
      id: Math.random().toString(36).slice(2, 10),
      name: shortText(source.name, '共有プロジェクト', 100) + '（共有コピー）',
      cableColor: validColor(source.cableColor, '#5866dc'),
      objects,
      wires,
      connectors: Array.isArray(source.connectors)
        ? source.connectors.slice(0, 100).map(value => shortText(value, '', 100)).filter(Boolean)
        : [],
      fontSize: numberInRange(source.fontSize, 14, 10, 32),
      fontWeight: source.fontWeight === '700' ? '700' : '600',
      sharedSourceId: shareId,
      updated: new Date().toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' })
    };
  }

  async function importSharedProject() {
    const shareId = new URLSearchParams(location.search).get('id');
    if (!shareId) return;
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(shareId)) {
      notify('共有URLのIDが正しくありません');
      return;
    }
    try {
      const client = await getClient();
      const result = await client.rpc('read_shared_diagram', { p_id: shareId });
      if (result.error) throw result.error;
      if (!result.data) throw new Error('共有データが見つからないか、削除されています');
      const api = window.__ccdShareAPI;
      let project = api.findImported(shareId);
      const existed = Boolean(project);
      if (project) api.openImported(project);
      else {
        project = sanitizeSharedProject(result.data, shareId);
        api.importShared(project);
      }
      notify(existed ? '共有プロジェクトを開きました' : '共有プロジェクトを端末にコピーしました');
    } catch (error) {
      notify('共有データを読み込めませんでした。共有用Supabaseの設定をご確認ください');
      console.error('Shared project import failed', error);
    }
  }

  function ensureShareButton() {
    const exportButton = document.getElementById('export');
    if (!exportButton || document.getElementById('shareProject')) return;
    const button = document.createElement('button');
    button.id = 'shareProject';
    button.type = 'button';
    button.textContent = '共有リンク';
    button.title = 'この配線図を閲覧専用リンクで共有';
    exportButton.before(button);
  }

  const app = document.getElementById('app');
  new MutationObserver(ensureShareButton).observe(app, { childList: true, subtree: true });
  ensureShareButton();
  document.addEventListener('click', event => {
    if (event.target.closest('#shareProject')) createShareLink();
  });
  void importSharedProject();
})();

