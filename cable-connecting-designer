<style>
:root{--bg:#f3f5f9;--paper:#fff;--ink:#202638;--muted:#798196;--line:#e5e8ef;--accent:#5b67e8;--shadow:0 3px 12px #20263818;--grid:24px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select{font:inherit;color:inherit}button{cursor:pointer;border:1px solid var(--line);background:white;border-radius:10px;padding:9px 13px;box-shadow:0 3px 7px #20263819;transition:transform .12s,box-shadow .12s}button:hover{box-shadow:0 4px 12px #20263825}button:active{transform:scale(.9)}button:disabled{opacity:.4;cursor:default}.primary{background:var(--accent);border-color:var(--accent);color:white}.icon-btn{width:40px;height:40px;padding:0;font-size:20px;display:grid;place-items:center}.quiet{background:transparent;box-shadow:none}.danger{color:#cc4242}.hidden{display:none!important}.app{min-height:100dvh}.topbar{height:62px;display:flex;align-items:center;gap:12px;padding:0 22px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}.brand{font-weight:750;font-size:16px;letter-spacing:-.3px;display:flex;align-items:center;gap:9px}.brandmark{width:30px;height:30px;border-radius:9px;background:#5b67e8;color:white;display:grid;place-items:center;font-size:17px}.top-spacer{flex:1}.topbar .project-name{font-weight:650}.color-control{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--muted)}input[type=color]{border:0;background:transparent;width:28px;height:28px;padding:0;cursor:pointer}.toolbar{display:flex;align-items:center;gap:8px;padding:10px 18px;background:#fff;border-bottom:1px solid var(--line);overflow-x:auto;white-space:nowrap}.toolbar-group{display:flex;align-items:center;gap:7px;padding-right:11px;border-right:1px solid var(--line)}.toolbar-group:last-child{border:0}.toolbar button{padding:8px 10px;border-radius:9px;font-size:13px}.tool-active{background:#eef0ff!important;color:#4753db!important;border-color:#