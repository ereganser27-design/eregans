 auto;padding:42px 26px}.page-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.page-heading h1{font-size:25px;margin:0 0 5px}.page-heading p{margin:0;color:var(--muted)}.project-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}.project-card{background:white;border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:var(--shadow);cursor:pointer;transition:transform .15s,box-shadow .15s;position:relative}.project-card:hover{transform:translateY(-2px);box-shadow:0 8px 22px #20263818}.preview{height:155px;background-color:#fbfcfe;background-image:radial-gradient(#dce1eb 1px,transparent 1px);background-size:18px 18px;position:relative;overflow:hidden}.preview-node{position:absolute;background:white;border:2px solid #6370e7;border-radius:6px;width:75px;height:35px;box-shadow:0 2px 5px #20263820}.preview-wire{height:2px;background:#5361db;position:absolute;transform-origin:left center}.card-info{padding:13px 15px;display:flex;align-items:center;justify-content:space-between}.card-info strong{font-size:14px}.card-date{font-size:11px;color:var(--muted)}.card-menu{position:absolute;right:9px;top:9px;z-index:2}.card-menu button{width:34px;height:34px;padding:0;background:#fffE}.context-menu{position:fixed;z-index:9;background:white;border:1px solid var(--line);border-radius:10px;padding:5px;box-shadow:0 9px 30px #20263828;min-width:130px}.context-menu button{width:100%;text-align:left;border:0;box-shadow:none}.modal-layer{position:fixed;inset:0;background:#18203969;display:grid;place-items:center;z-index:20;padding:15px}.modal{width:min(470px,100%);max-height:90dvh;overflow:auto;background:white;border-radius:16px;padding:23px;box-shadow:0 20px 65px #161c3044}.modal h2{margin:0 0 16px;font-size:20px}.modal p{color:var(--muted);margin:0 0 15px}.field{display:block;margin:12px 0}.field span{display:block;font-size:12px;color:#626c81;margin-bottom:6px}.field input,.field select{width:100%;padding:10px 11px;border:1px solid var(--line);border-radius:9px;background:white;outline:none}.field input:focus,.field select:focus{border-color:#7f89ed;box-shadow:0 0 0 3px #6b77e51c}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.choice-list{display:grid;gap:8px}.choice-list button{text-align:left}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#242b3c;color:white;padding:9px 15px;border-radius:20px;z-index:30;box-shadow:var(--shadow)}.status-dot{width:7px;height:7px;background:#62be85;border-radius:50%;display:inline-block;margin-right:5px}.mobile-label{display:none}
@media(max-width:700px){.topbar{height:56px;padding:0 12px;gap:8px}.brand{font-size:14px}.brandmark{width:28px;height:28px}.toolbar{padding:8px 10px;gap:6px}.toolbar-group{gap:5px;padding-right:7px}.toolbar button{font-size:12px;padding:8px}.workspace{height:calc(100dvh - 104px)}.topbar .color-control span{display:none}.topbar .project-name{font-size:13px}.projects-page{padding:26px 15px}.page-heading h1{font-size:21px}.project-grid{grid-template-columns:1fr 1fr;gap:11px}.preview{height:120px}.card-info{padding:10px}.card-info strong{font-size:12px}.card-date{display:none}.field-row{gap:8px}}
</style><style>.workspace{cursor:default}.workspace.panning{cursor:grabbing}.wires{z-index:2}#objects{position:absolute;inset:0;z-index:1;pointer-events:none}.object{pointer-events:auto}.wire-hit{fill:none;stroke:transparent;stroke-width:18;pointer-events:stroke;cursor:grab}.wire-endpoint{fill:#fff;stroke:#5361db;stroke-width:3;r:7px;cursor:grab;pointer-events:all}.wire-endpoint:hover{fill:#e8eaff;stroke-width:4}.wire-endpoint:active{cursor:grabbing}.wire-label{pointer-events:none}.list-dropdown{position:absolute;top:calc(100% + 5px);right:8px;width:min(340px,calc(100vw - 16px));max-height:65vh;overflow:auto;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 32px #2026382e;padding:8px;z-index:12}.list-heading{padding:8px 9px 5px;color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase}.list-entry{display:block;width:100%;text-align:left;border:0;box-shadow:none;padding:9px 10px;border-radius:8px;white-space:normal}.list-entry:hover{background:#f2f4ff;box-shadow:none}.list-entry small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.list-empty{padding:7px 10px;color:var(--muted);font-size:12px}.cable-palette{position:absolute;top:calc(100% + 5px);right:150px;display:flex;flex-wrap:wrap;gap:7px;width:190px;padding:10px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 10px 25px #20263825;z-index:12}.color-swatch{width:29px;height:29px;min-width:29px;padding:0;border:2px solid white;border-radius:50%;background:var(--swatch);box-shadow:0 0 0 1px #0002;cursor:pointer}.color-swatch:hover{box-shadow:0 0 0 2px #5966e8}.palette-hint{width:100%;font-size:11px;color:var(--muted);padding:1px 2px}</style>
<style>.resize-handle{position:absolute;width:18px;height:18px;right:-7px;bottom:-7px;border:2px solid white;border-radius:5px;background:#5966e8;box-shadow:0 1px 4px #20263855;cursor:nwse-resize;touch-action:none}.connection-port{position:absolute;width:16px;height:16px;border:3px solid #5361db;border-radius:50%;background:#fff;z-index:5;cursor:crosshair;touch-action:none}.connection-port:hover{background:#e4e8ff;transform:scale(1.2)}.connection-port.cp-left{left:-9px;top:calc(50% - 8px)}.connection-port.cp-right{right:-9px;top:calc(50% - 8px)}.connection-port.cp-top{top:-9px;left:calc(50% - 8px)}.connection-port.cp-bottom{bottom:-9px;left:calc(50% - 8px)}</style></head>
<body><div class="app" id="app"></div><div id="modalRoot"></div><div id="menuRoot"></div><div id="toastRoot"></div>
<script>
(()=>{'use strict';
const KEY='ccd-projects-v1';let projects=load(),currentId=null,view='home',scale=1,pan={x:0,y:0},activeTool='select',history=[],future=[],selectedWire=null,drag=null,modalState=null,suppressWireClick=false;
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function load(){try{let data=JSON.parse(localStorage.getItem(KEY)||'[]');data.forEach(p=>{delete p.color;p.objects?.forEach(o=>{o.color||='#5966e8'})});return data}catch{return []}}function save(){localStorage.setItem(KEY,JSON.stringify(projects))}function project(){return projects.find(p=>p.id===currentId)}function uid(){return Math.random().toString(36).slice(2,10)}function toast(s){$('#toastRoot').innerHTML=`<div class="toast">${esc(s)}</div>`;setTimeout(()=>$('#toastRoot').innerHTML='',2200)}function stamp(){return new Date().toLocaleDateString('ja-JP',{year:'numeric',month:'short',day:'numeric'})}
function render(){const p=project();$('#app').innerHTML=view==='home'?homeHTML():editorHTML(p);$('#projectColor')?.parentElement.remove();if(view==='editor'&&p){paintWorld();syncToolbar(p);let hint=$('#workspace .workspace-hint');hint.textContent=activeTool==='cable'?'オブジェクトの上・下・左・右の接続ポートを選択':activeTool==='object'?'キャンバスをクリックして配置':'左ドラッグ：オブジェクト移動・サイズ変更／ケーブル端点・折れ位置の移動　中クリックドラッグ：方眼移動';insertListDropdown(p);initCablePalette(p)}}
function insertListDropdown(p){let spacer=$('#app .topbar .top-spacer');if(!spacer)return;let button=document.createElement('button');button.id='listToggle';button.textContent='一覧 ▾';button.title='オブジェクト・ケーブル一覧';spacer.after(button);let panel=document.createElement('div');panel.id='listDropdown';panel.className='list-dropdown hidden';let objects=p.objects.length?p.objects.map(o=>`<button class="list-entry" data-list-object="${o.id}">▢ ${esc(o.name)}<small>${Math.round(o.w)} × ${Math.round(o.h)}</small></button>`).join(''):'<div class="list-empty">オブジェクトはありません</div>';let wires=p.wires.length?p.wires.map(w=>{let a=p.objects.find(o=>o.id===w.from),b=p.objects.find(o=>o.id===w.to);return `<button class="list-entry" data-list-wire="${w.id}">⌁ ${esc(w.name||'名前未設定')}<small>${esc(a?.name||'自由端')} → ${esc(b?.name||'自由端')}${w.connectorA||w.connectorB?` · ${esc(w.connectorA||'なし')} / ${esc(w.connectorB||'なし')}`:''}</small></button>`}).join(''):'<div class="list-empty">ケーブルはありません</div>';panel.innerHTML=`<div class="list-heading">オブジェクト（${p.objects.length}）</div>${objects}<div class="list-heading">ケーブル（${p.wires.length}）</div>${wires}`;spacer.parentElement.append(panel)}
function initCablePalette(p){let color=$('#cableColor');if(!color)return;let button=document.createElement('button');button.id='cablePaletteToggle';button.textContent='色 ▾';button.title='新しいケーブルの既定色';color.parentElement.after(button);let panel=document.createElement('div');panel.id='cablePalette';panel.className='cable-palette hidden';let choices=['#5866dc','#e64b4b','#ed8a28','#e0b51b','#36a269','#1596a5','#7854bc','#303642'];panel.innerHTML=`<div class="palette-hint">新しく作成するケーブルの既定色</div>${choices.map(c=>`<button class="color-swatch" data-cable-color="${c}" style="--swatch:${c}" title="${c}" aria-label="${c}"></button>`).join('')}`;$('#app .topbar').append(panel)}
function focusListed(kind,id){let p=project(),point;if(kind==='object'){let o=p.objects.find(x=>x.id===id);if(!o)return;selectedWire=id;point={x:o.x+o.w/2,y:o.y+o.h/2}}else{let w=p.wires.find(x=>x.id===id);if(!w)return;selectedWire=id;let a=p.objects.find(x=>x.id===w.from),b=p.objects.find(x=>x.id===w.to),A=wireEndPoint(w,'from',a),B=wireEndPoint(w,'to',b);point={x:(A.x+B.x)/2,y:(A.y+B.y)/2}}let r=$('#workspace').getBoundingClientRect();pan.x=r.width/2-point.x*scale;pan.y=r.height/2-point.y*scale;render()}
function homeHTML(){return `<header class="topbar"><div class="brand"><span class="brandmark">⌁</span>Cable Connecting Designer</div><div class="top-spacer"></div><span style="font-size:12px;color:var(--muted)"><i class="status-dot"></i>この端末に保存</span></header><main class="projects-page"><div class="page-heading"><div><h1>プロジェクト</h1><p>配線図を作成・管理しましょう</p></div><button class="primary" id="newProject">＋ 新規作成</button></div>${projects.length?`<div class="project-grid">${projects.map(p=>`<article class="project-card" data-open="${p.id}" oncontextmenu="event.preventDefault();showProjectMenu('${p.id}',event.clientX,event.clientY)"><button class="card-menu quiet" aria-label="メニュー" onclick="event.stopPropagation();showProjectMenu('${p.id}',event.clientX,event.clientY)">⋯</button><div class="preview">${previewHTML(p)}</div><div class="card-info"><strong>${esc(p.name)}</strong><span class="card-date">${p.updated||'新規'}</span></div></article>`).join('')}</div>`:`<div class="empty-state"><div class="emoji">🧩</div><h2>プロジェクトを作成しましょう</h2><p>＋ 新規作成から、最初の配線図を作れます。</p><button class="primary" id="newProject2">＋ プロジェクトを作成</button></div>`}</main>`}
function previewHTML(p){if(!p.objects?.length)return '<div style="position:absolute;inset:0;display:grid;place-items:center;color:#a4aabd;font-size:12px">プレビュー</div>';let maxX=Math.max(160,...p.objects.map(o=>o.x+o.w)),maxY=Math.max(100,...p.objects.map(o=>o.y+o.h)),sx=140/maxX,sy=90/maxY,k=Math.min(sx,sy,1);return (p.wires||[]).map(w=>{let a=p.objects.find(o=>o.id===w.from),b=p.objects.find(o=>o.id===w.to);if(!a||!b)return '';let x=(a.x+a.w/2)*k,y=(a.y+a.h/2)*k,xx=(b.x+b.w/2)*k,yy=(b.y+b.h/2)*k,dx=xx-x,dy=yy-y;return `<i class="preview-wire" style="left:${x}px;top:${y}px;width:${Math.hypot(dx,dy)}px;transform:rotate(${Math.atan2(dy,dx)}rad)"></i>`}).join('')+p.objects.map(o=>`<i class="preview-node" style="left:${o.x*k}px;top:${o.y*k}px;width:${o.w*k}px;height:${o.h*k}px"></i>`).join('')}
function editorHTML(p){if(!p)return homeHTML();return `<header class="topbar"><button id="back" class="quiet" style="padding:8px">← 戻る</button><div class="brand"><span class="brandmark">⌁</span></div><div class="project-name">${esc(p.name)}</div><div class="top-spacer"></div><label class="color-control"><span>プロジェクト</span><input type="color" id="projectColor" value="${p.color||'#5966e8'}"></label><label class="color-control"><span>ケーブル</span><input type="color" id="cableColor" value="${p.cableColor||'#5866dc'}"></label><button id="undo" title="やり直し（Ctrl+Z）" ${history.length?'':'disabled'}>↶</button><button id="redo" title="戻す（Ctrl+Y）" ${future.length?'':'disabled'}>↷</button><button id="export" class="primary">保存・書き出し</button></header><nav class="toolbar"><div class="toolbar-group"><button id="selectTool" class="${activeTool==='select'?'tool-active':''}">↖ 選択</button><button id="objectTool" class="${activeTool==='object'?'tool-active':''}">▢ オブジェクト＋</button><button id="cableTool" class="${activeTool==='cable'?'tool-active':''}">⌁ ケーブル＋</button></div><div class="toolbar-group"><button id="connectorManage">🔌 コネクター登録</button><button id="styleSetup">Aa 文字・表示設定</button></div><div class="toolbar-group"><span style="font-size:12px;color:var(--muted)">${p.objects.length} オブジェクト · ${p.wires.length} ケーブル</span></div></nav><main class="workspace" id="workspace"><div class="world" id="world"><svg class="wires" id="wires"></svg><div id="objects"></div></div><div class="workspace-hint">${activeTool==='cable'?'始点のオブジェクト、次に終点をクリック':activeTool==='object'?'キャンバスをクリックして配置':'ドラッグで移動 · スクロール/ピンチで拡大縮小 · 空白をドラッグで移動'}</div><div class="zoom-controls"><button id="zoomOut">−</button><button id="zoomReset" style="font-size:12px">${Math.round(scale*100)}%</button><button id="zoomIn">＋</button></div></main>`}
function syncToolbar(p){$('#world').style.transform=`translate(${pan.x}px,${pan.y}px) scale(${scale})`;$('#workspace').style.setProperty('--grid',`${24*scale}px`);$('#workspace').classList.toggle('panning',!!drag?.pan);$('#workspace').style.cursor=activeTool==='cable'?'crosshair':activeTool==='object'?'copy':'';}
function anchorPoint(o,a,sideOverride){let side=sideOverride||a?.side||'right',t=Math.max(0,Math.min(1,a?.t??.5));if(side==='left')return{x:o.x,y:o.y+o.h*t};if(side==='right')return{x:o.x+o.w,y:o.y+o.h*t};if(side==='top')return{x:o.x+o.w*t,y:o.y};return{x:o.x+o.w*t,y:o.y+o.h}}
function anchorFromWorldPoint(o,pt,orientation){let x=pt.x-o.x,y=pt.y-o.y,all=[{side:'left',d:x,t:y/o.h},{side:'right',d:o.w-x,t:y/o.h},{side:'top',d:y,t:x/o.w},{side:'bottom',d:o.h-y,t:x/o.w}],eligible=orientation==='vertical'?all.filter(a=>a.side==='top'||a.side==='bottom'):orientation==='horizontal'?all.filter(a=>a.side==='left'||a.side==='right'):all,nearest=eligible.sort((a,b)=>a.d-b.d)[0];return{side:nearest.side,t:Math.max(0,Math.min(1,nearest.t))}}
function anchorOnFace(o,pt,side){let t=(side==='left'||side==='right')?(pt.y-o.y)/o.h:(pt.x-o.x)/o.w;return{side,t:Math.max(0,Math.min(1,t))}}
function anchorFromEvent(el,e,orientation){let o=project().objects.find(x=>x.id===el.dataset.object);return anchorFromWorldPoint(o,workspacePoint(e),orientation)}
